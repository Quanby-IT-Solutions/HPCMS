# ==========================================================
# WEB APP ENVIRONMENT VARIABLES
# ==========================================================

# Server Configuration
NODE_ENV=development

# Server-only internal API URL (optional, useful in Docker/container networks)
# INTERNAL_API_BASE_URL=http://backend:3000/api

# Public URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_VERSION=v1

# SMART on FHIR clinician launch
# Space- or comma-separated list of CSP frame-ancestors allowed to embed /clinician/*.
NEXT_PUBLIC_EMR_FRAME_ORIGINS="http://localhost:* https://*.altera-sunrise.dev"
NEXT_PUBLIC_SMART_CLIENT_ID=pcms-dev
NEXT_PUBLIC_SMART_REDIRECT_URI=http://localhost:3001/clinician/callback
NEXT_PUBLIC_SMART_SCOPES="launch openid fhirUser patient/*.read"
